<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/roamly_logo"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/biometric_unlock_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#082B4C"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/biometric_unlock_message"
        android:textSize="15sp"
        android:textColor="#7B8794"
        android:gravity="center" />

    <TextView
        android:id="@+id/biometricStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/biometric_waiting"
        android:textSize="13sp"
        android:textColor="#7B8794"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biometricRetryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/biometric_try_again"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        app:backgroundTint="#194A73"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/biometricGoogleButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/biometric_use_google"
        android:textAllCaps="false"
        android:textColor="#194A73"
        app:backgroundTint="#E4F1FC"
        app:cornerRadius="14dp" />

</LinearLayout>
