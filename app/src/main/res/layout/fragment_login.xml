<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <LinearLayout
        android:id="@+id/loginContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/roamlyLogoImageView"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/firebase_roamly_title"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/roamlyTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/firebase_roamly_title"
            android:textColor="#172B3A"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginHeadingTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/firebase_login_heading"
            android:textColor="#172B3A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/firebase_login_subtitle"
            android:textColor="#718096"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/googleSignInButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:text="@string/firebase_google_button"
            android:textAllCaps="false"
            android:textColor="#172B3A"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD5E0" />

        <ProgressBar
            android:id="@+id/googleSignInProgressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/googleSignInStatusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/firebase_signing_in"
            android:textColor="#718096"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>