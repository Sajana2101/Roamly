<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/roamly_background"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/roamly_white"
            android:elevation="4dp"
            android:title="My Holidays"
            android:titleTextColor="@color/roamly_text_primary" />

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- CUSTOM ROAMLY BOTTOM NAVIGATION -->
        <FrameLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@android:color/transparent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- White navigation bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_gravity="bottom"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="0dp"
                app:cardElevation="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Thin top divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="top"
                        android:background="#E1E5E9" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- HOME -->
                        <LinearLayout
                            android:id="@+id/nav_home"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/navHomeIcon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_nav_home"
                                android:contentDescription="Home"
                                app:tint="#2C79BD" />

                            <TextView
                                android:id="@+id/navHomeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Home"
                                android:textColor="#2C79BD"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- ITINERARY -->
                        <LinearLayout
                            android:id="@+id/nav_itinerary"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/navItineraryIcon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_nav_itinerary"
                                android:contentDescription="Itinerary"
                                app:tint="#666B72" />

                            <TextView
                                android:id="@+id/navItineraryText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Itinerary"
                                android:textColor="#666B72"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <!-- ADD HOLIDAY SLOT -->
                        <LinearLayout
                            android:id="@+id/nav_add_holiday"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="bottom|center_horizontal"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingBottom="5dp">

                            <Space
                                android:layout_width="1dp"
                                android:layout_height="42dp" />

                            <TextView
                                android:id="@+id/navAddHolidayText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add Holiday"
                                android:textColor="#666B72"
                                android:textSize="10sp"
                                android:gravity="center"
                                android:maxLines="1" />

                        </LinearLayout>

                        <!-- PACKING -->
                        <LinearLayout
                            android:id="@+id/nav_packing"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/navPackingIcon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_nav_packing"
                                android:contentDescription="Packing"
                                app:tint="#666B72" />

                            <TextView
                                android:id="@+id/navPackingText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Packing"
                                android:textColor="#666B72"
                                android:textSize="10sp" />

                        </LinearLayout>

                        <!-- DOCUMENTS -->
                        <LinearLayout
                            android:id="@+id/nav_documents"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="8dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/navDocumentsIcon"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_nav_documents"
                                android:contentDescription="Documents"
                                app:tint="#666B72" />

                            <TextView
                                android:id="@+id/navDocumentsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Documents"
                                android:textColor="#666B72"
                                android:textSize="10sp" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Raised centre Add Holiday circle -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/navAddHolidayButton"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_add_holiday_circle"
                android:contentDescription="Add Holiday"
                android:elevation="10dp"
                android:padding="17dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_add"
                app:tint="#17344E" />

        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/roamly_white"
        android:fitsSystemWindows="true"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>