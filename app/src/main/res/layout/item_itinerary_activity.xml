<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <!-- Displays the activity start time beside the timeline -->
    <TextView
        android:id="@+id/tvActivityItemTime"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/_08_30_am"
        android:textColor="#6D7A86"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Contains the circular activity icon and the timeline line -->
    <LinearLayout
        android:layout_width="38dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- The displayed icon changes depending on the type of activity -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActivityTypeIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:cardBackgroundColor="#E5F2FD"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgActivityTypeIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_place"
                app:tint="#2F8FD8" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Continues the itinerary timeline underneath the icon -->
        <View
            android:layout_width="2dp"
            android:layout_height="54dp"
            android:background="#D9E4EC" />

    </LinearLayout>

    <!-- Main activity card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="#E5EBF0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvActivityItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_title"
                android:textColor="#172B3A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Thin divider shown between the activity information and actions -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#EDF1F4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <!-- Pencil icon with Edit -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditActivityItem"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/edit_activity"
                    android:textAllCaps="false"
                    android:textColor="#2F8FD8"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="13dp"
                    app:iconTint="#2F8FD8" />

                <!-- Bin icon with Delete -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteActivityItem"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/delete_itinerary_activity"
                    android:textAllCaps="false"
                    android:textColor="#D95C5C"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="13dp"
                    app:iconTint="#D95C5C" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>