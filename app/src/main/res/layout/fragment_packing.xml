<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Small page label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GET READY"
        android:textColor="#3F51B5"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp" />

    <!-- Heading and New List button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Page heading -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Packing Lists"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Add new packing list -->
        <Button
            android:id="@+id/btnAddPackingList"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="+ New List"
            android:backgroundTint="#3F51B5"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"  />

    </LinearLayout>

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Organise everything you need for your trip"
        android:textSize="10sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:progressDrawable="@drawable/packing_progress"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

     <!-- Packing lists -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPackingLists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>