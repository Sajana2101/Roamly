<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Back to all lists -->
    <TextView
        android:id="@+id/allListsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" ‹ All Lists"
        android:textSize="15sp"
        android:textColor="#3F51B5"
        android:textStyle="bold"
        android:paddingVertical="10dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

    <!-- Small page label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PACKING LIST"
        android:textColor="#3F51B5"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="4dp"
        tools:ignore="HardcodedText" />

    <!-- Packing list title and buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Packing list name -->
        <TextView
            android:id="@+id/txtPackingListTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Packing List Name"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />


        <!-- Edit packing list -->
        <ImageButton
            android:id="@+id/btnEditPackingList"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/edit_packing_list"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_edit"
            app:tint="#266FAD"
            app:backgroundTint="#5C2F8FD8"
            tools:ignore="TouchTargetSizeCheck" />

        <!-- Delete packing list -->
        <ImageButton
            android:id="@+id/btnDeletePackingList"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:backgroundTint="#FDECEC"
            android:contentDescription="@string/delete_packing_list"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="#D95C5C"
            tools:ignore="TouchTargetSizeCheck" />

        <!-- Add packing item -->
        <ImageButton
            android:id="@+id/btnAddPackingItem"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:backgroundTint="#2F8FD8"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            app:tint="#FFFFFF"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

    </LinearLayout>

    <!-- Packing list description -->
    <TextView
        android:id="@+id/packingListDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/packing_list_description"
        android:textSize="16sp" />


    <!-- Packing progress card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="#DADFE5"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Packing progress text -->
            <TextView
                android:id="@+id/txtPackingProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="8dp"
                android:text="0 of 0 packed"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/packingProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressDrawable="@drawable/packing_progress"
                android:max="100"
                android:progress="0" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>



    <!-- Packing items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPackingItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

</LinearLayout>