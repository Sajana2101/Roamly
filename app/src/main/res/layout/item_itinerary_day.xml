<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="76dp"
    android:layout_height="72dp"
    android:layout_marginEnd="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="13dp"
    app:cardElevation="0dp"
    app:strokeColor="#E1E7EC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/day_1itemitinerary"
            android:textColor="#7B8794"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvDayCardDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/_12_sep_itemitinerary"
            android:textColor="#172B3A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDayWeekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sat_itemitinerary"
            android:textColor="#7B8794"
            android:textSize="10sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>